@model List<SmakoszApp.Models.ExternalMeal>

@{
    ViewData["Title"] = "Home Page";
    string selectedCat = ViewBag.SelectedCategory ?? "";
    string selectedCuis = ViewBag.SelectedCuisine ?? "";
    string searchQ = ViewBag.SearchQuery ?? "";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="smakosz-main-container">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="success-alert">
            <span>@TempData["SuccessMessage"]</span>
            <button type="button" class="close-alert-btn" onclick="this.parentElement.style.display='none'">&times;</button>
        </div>
    }

    <!-- Search box -->
    <form method="get" asp-action="Index" id="filterForm">
        <input type="hidden" name="category" id="hiddenCategory" value="@selectedCat" />
        <input type="hidden" name="cuisine" id="hiddenCuisine" value="@selectedCuis" />
        <input type="hidden" name="page" id="hiddenPage" value="@(ViewBag.CurrentPage ?? 1)" />

        <div class="search-box-container">
            <input type="text"
                   name="search"
                   class="search-box-input"
                   id="searchInput"
                   value="@searchQ"
                   placeholder="Find your recipe (e.g., Chicken, Pasta, Beef)..." />
        </div>
    </form>

    <div class="divider-line">filters</div>

    <!-- Filter Dropdowns -->
    <div class="filters-flex-box">
        <div class="custom-dropdown">
            <button class="custom-filter-btn" type="button" id="catBtn">
                @(string.IsNullOrEmpty(selectedCat) ? "Category" : char.ToUpper(selectedCat[0]) + selectedCat.Substring(1))
            </button>
            <div class="custom-dropdown-content">
                <label class="radio-label"><input type="radio" name="MainCategory" value="chicken" @(selectedCat == "chicken" ? "checked" : "")><span class="radio-circle"></span> Chicken</label>
                <label class="radio-label"><input type="radio" name="MainCategory" value="beef" @(selectedCat == "beef" ? "checked" : "")><span class="radio-circle"></span> Beef</label>
                <label class="radio-label"><input type="radio" name="MainCategory" value="pasta" @(selectedCat == "pasta" ? "checked" : "")><span class="radio-circle"></span> Pasta</label>
                <label class="radio-label"><input type="radio" name="MainCategory" value="seafood" @(selectedCat == "seafood" ? "checked" : "")><span class="radio-circle"></span> Seafood</label>
                <label class="radio-label"><input type="radio" name="MainCategory" value="vegetarian" @(selectedCat == "vegetarian" ? "checked" : "")><span class="radio-circle"></span> Vegetarian</label>
                <label class="radio-label"><input type="radio" name="MainCategory" value="vegan" @(selectedCat == "vegan" ? "checked" : "")><span class="radio-circle"></span> Vegan</label>
                <label class="radio-label"><input type="radio" name="MainCategory" value="dessert" @(selectedCat == "dessert" ? "checked" : "")><span class="radio-circle"></span> Dessert</label>
                <label class="radio-label"><input type="radio" name="MainCategory" value="starter" @(selectedCat == "starter" ? "checked" : "")><span class="radio-circle"></span> Starter</label>
            </div>
        </div>

        <div class="custom-dropdown">
            <button class="custom-filter-btn" type="button" id="cuisBtn">
                @(string.IsNullOrEmpty(selectedCuis) ? "Cuisine" : char.ToUpper(selectedCuis[0]) + selectedCuis.Substring(1))
            </button>
            <div class="custom-dropdown-content">
                <label class="radio-label"><input type="radio" name="CuisineType" value="italian" @(selectedCuis == "italian" ? "checked" : "")><span class="radio-circle"></span> Italian</label>
                <label class="radio-label"><input type="radio" name="CuisineType" value="polish" @(selectedCuis == "polish" ? "checked" : "")><span class="radio-circle"></span> Polish</label>
                <label class="radio-label"><input type="radio" name="CuisineType" value="american" @(selectedCuis == "american" ? "checked" : "")><span class="radio-circle"></span> American</label>
                <label class="radio-label"><input type="radio" name="CuisineType" value="japanese" @(selectedCuis == "japanese" ? "checked" : "")><span class="radio-circle"></span> Japanese</label>
                <label class="radio-label"><input type="radio" name="CuisineType" value="mexican" @(selectedCuis == "mexican" ? "checked" : "")><span class="radio-circle"></span> Mexican</label>
                <label class="radio-label"><input type="radio" name="CuisineType" value="chinese" @(selectedCuis == "chinese" ? "checked" : "")><span class="radio-circle"></span> Chinese</label>
                <label class="radio-label"><input type="radio" name="CuisineType" value="french" @(selectedCuis == "french" ? "checked" : "")><span class="radio-circle"></span> French</label>
                <label class="radio-label"><input type="radio" name="CuisineType" value="greek" @(selectedCuis == "greek" ? "checked" : "")><span class="radio-circle"></span> Greek</label>
            </div>
        </div>
    </div>

    <!-- Dynamic Content Container -->
    <div id="dynamicContentContainer">
        @await Html.PartialAsync("_RecipesListPartial", Model)
    </div>

</div>

@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}