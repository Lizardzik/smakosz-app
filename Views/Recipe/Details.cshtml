@model SmakoszApp.Models.ExternalMeal

@{
    ViewData["Title"] = Model.StrMeal;
    double avgScore = ViewBag.AverageScore ?? 0.0;
    int totalVotes = ViewBag.TotalVotes ?? 0;
    var breakdown = ViewBag.StarBreakdown as Dictionary<int, int> ?? new Dictionary<int, int>();
    bool isFav = ViewBag.IsFavorite ?? false;

    // Pobranie ID wideo z YouTube
    string youtubeEmbedUrl = "";
    if (!string.IsNullOrEmpty(Model.StrYoutube) && Model.StrYoutube.Contains("v="))
    {
        var videoId = Model.StrYoutube.Split("v=")[1].Split("&")[0];
        youtubeEmbedUrl = $"https://www.youtube.com/embed/{videoId}";
    }

    var ingredientsList = Model.GetIngredientsList();
    var rawInstructions = Model.StrInstructions ?? "";

    var lines = rawInstructions
            .Split(new[] { "\r\n", "\n", "\r" }, StringSplitOptions.RemoveEmptyEntries)
            .Select(l => l.Trim())
            .Where(l => !string.IsNullOrWhiteSpace(l))
            .ToList();

    var steps = new List<string>();

    for (int i = 0; i < lines.Count; i++)
    {
        var currentLine = lines[i];

        if (System.Text.RegularExpressions.Regex.IsMatch(currentLine, @"^STEP\s*\d+:?$", System.Text.RegularExpressions.RegexOptions.IgnoreCase))
        {
            if (i + 1 < lines.Count)
            {
                steps.Add(lines[i + 1]);
                i++;
            }
        }
        else
        {
            var sanitized = System.Text.RegularExpressions.Regex.Replace(currentLine, @"^STEP\s*\d+:?\s*", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);

            if (!string.IsNullOrWhiteSpace(sanitized))
            {
                steps.Add(sanitized);
            }
        }
    }

    if (steps.Count <= 1 && rawInstructions.Length > 150)
    {
        steps = rawInstructions
            .Split(new[] { ". " }, StringSplitOptions.RemoveEmptyEntries)
            .Select(s => s.Trim().TrimEnd('.'))
            .Where(s => s.Length > 10)
            .ToList();
    }

    var commentsList = ViewBag.Comments as List<SmakoszApp.Models.Comment> ?? new List<SmakoszApp.Models.Comment>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/recipe-details.css" asp-append-version="true" />
}

<div class="recipe-details-container my-4">

    <!-- TOP HERO SECTION -->
    <div class="details-top-section">
        <div class="details-image-box">
            <img src="@Model.StrMealThumb" alt="@Model.StrMeal" />
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <button type="button"
                        class="details-favorite-btn @(isFav ? "active" : "")"
                        data-id="@Model.IdMeal"
                        data-title="@Model.StrMeal"
                        data-thumb="@Model.StrMealThumb"
                        data-category="@Model.StrCategory"
                        data-area="@Model.StrArea">
                    <svg class="heart-icon" viewBox="0 0 24 24" width="26" height="26">
                        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
                    </svg>
                </button>
            }
        </div>

        <div class="details-info-box">
            <h1 class="details-title">@Model.StrMeal</h1>

            <div class="details-tags-row">
                @if (!string.IsNullOrEmpty(Model.StrArea))
                {
                    <span class="info-pill">🌍 Cuisine: <strong>@Model.StrArea</strong></span>
                }
                @if (!string.IsNullOrEmpty(Model.StrCategory))
                {
                    <span class="info-pill">🏷️ Category: <strong>@Model.StrCategory</strong></span>
                }
            </div>

            <!-- INGREDIENTS LIST -->
            <div class="details-ingredients-card mt-4">
                <h3>Ingredients Required</h3>
                <p class="ingredients-hint">Check items as you prepare:</p>
                <ul class="ingredients-list">
                    @foreach (var ingredient in ingredientsList)
                    {
                        <li>
                            <label class="ingredient-checkbox-label">
                                <input type="checkbox" class="ingredient-checkbox" />
                                <span class="checkbox-custom"></span>
                                <span class="ingredient-text">@ingredient</span>
                            </label>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <!-- INSTRUCTIONS SECTION -->
    <div class="details-instructions-card my-5">
        <h2>Preparation Steps</h2>
        <div class="steps-wrapper">
            @if (steps.Any())
            {
                int stepNum = 1;
                foreach (var step in steps)
                {
                    <div class="step-item">
                        <div class="step-number">@stepNum</div>
                        <div class="step-text">@step</div>
                    </div>
                    stepNum++;
                }
            }
            else
            {
                <p>No preparation steps available for this recipe.</p>
            }
        </div>
    </div>

    <!-- VIDEO SECTION -->
    @if (!string.IsNullOrEmpty(youtubeEmbedUrl))
    {
        <div class="details-video-card my-5">
            <h2>Video Tutorial</h2>
            <div class="video-responsive-wrapper">
                <iframe src="@youtubeEmbedUrl" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
            </div>
        </div>
    }

    <!-- RATINGS BREAKDOWN & USER RATING SECTION -->
    <div class="details-ratings-card my-5">
        <h2>Community Ratings</h2>

        <div class="ratings-dashboard">
            <div class="rating-summary-box">
                <div class="big-score">@(avgScore > 0 ? avgScore.ToString("0.0") : "0.0")</div>
                <div class="stars-display">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <span class="star @(i <= Math.Round(avgScore) ? "filled" : "")">&#9733;</span>
                    }
                </div>
                <div class="total-votes-count">Based on <strong>@totalVotes</strong> @(totalVotes == 1 ? "review" : "reviews")</div>

                <div class="user-rate-action mt-3">
                    <span>Rate this recipe:</span>
                    <div class="interactive-stars" data-id="@Model.IdMeal">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <span class="interactive-star" data-value="@i">&#9733;</span>
                        }
                    </div>
                </div>
            </div>

            <div class="rating-bars-box">
                @for (int star = 5; star >= 1; star--)
                {
                    int count = breakdown.ContainsKey(star) ? breakdown[star] : 0;
                    double percent = totalVotes > 0 ? (double)count / totalVotes * 100 : 0;

                    <div class="bar-row">
                        <span class="star-label">@star ★</span>
                        <div class="bar-container">
                            <div class="bar-fill" style="width: @percent.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%;"></div>
                        </div>
                        <span class="count-label">@count</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- COMMENTS SECTION -->
    <div class="details-comments-card my-5">
        <h2>Discussion & Tips (@commentsList.Count)</h2>

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <div class="add-comment-box mb-4">
                <div id="commentErrorBox" class="alert alert-danger d-none mb-3" role="alert"></div>

                <form id="commentForm" onsubmit="return false;">
                    <textarea id="commentInput" class="comment-textarea" rows="3" placeholder="Share your cooking tips or thoughts about this recipe..."></textarea>
                    <div class="text-end mt-2">
                        <button type="button" id="submitCommentBtn" class="btn-submit-comment" data-id="@Model.IdMeal">Post Comment</button>
                    </div>
                </form>
            </div>
        }
        else
        {
            <div class="guest-comment-notice mb-4 text-center">
                <p>Want to join the discussion and earn Leaderboard points? <a href="/Account/Index">Log in or Sign Up</a></p>
            </div>
        }

        <div class="comments-list" id="commentsContainer">
            @if (!commentsList.Any())
            {
                <p class="no-comments-text text-center py-3">No comments yet. Be the first to share your thoughts!</p>
            }
            else
            {
                foreach (var c in commentsList)
                {
                    var avatarPath = !string.IsNullOrEmpty(c.User?.ProfilePicturePath)
                        ? c.User.ProfilePicturePath
                        : "/uploads/avatars/default-avatar.png";

                    <div class="comment-item d-flex gap-3 align-items-start">
                        <img src="@avatarPath" alt="Avatar" class="comment-avatar-img" />

                        <div class="comment-content-body flex-grow-1">
                            <div class="comment-header d-flex justify-content-between align-items-center mb-1">
                                <span class="comment-author font-weight-bold">@(c.User?.Login ?? "Anonymous")</span>
                                <span class="comment-date text-muted small">@c.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                            </div>
                            <p class="comment-text mb-2">@c.Text</p>
                            <div class="comment-actions">
                                <button type="button" class="like-comment-btn" data-id="@c.Id">
                                    👍 <span class="like-count">@c.LikesCount</span>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- DEDYKOWANA SEKCJA DLA PRZYCISKU EDYCJI PRZEPISU -->
    <div class="customize-banner-card my-5 text-center p-4">
        <h3 class="font-serif fw-bold mb-2">Want to tweak this recipe?</h3>
        <p class="text-muted mb-3">Adjust ingredients or steps to your taste and save your private customized copy.</p>

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <button type="button" class="btn-customize-recipe" data-bs-toggle="modal" data-bs-target="#customizeModal">
                ✏️ Customize & Save My Version
            </button>
        }
        else
        {
            <a href="/Account/Index" class="btn btn-outline-dark rounded-pill px-4">Log in to Customize</a>
        }
    </div>

    <!-- BACK ACTION -->
    <div class="details-actions my-5 text-center">
        <a href="/Home/Index" class="back-home-btn">&larr; Back to Recipes</a>
    </div>

</div>

<!-- MODAL EDYCJI PRZEPISU -->
<div class="modal fade" id="customizeModal" tabindex="-1" aria-labelledby="customizeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="border-radius: 20px; border: 2px solid var(--color-dark, #2D3142);">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold font-serif fs-4" id="customizeModalLabel">Customize Recipe</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">Personalize ingredients or preparation steps. This will save a private copy under <strong>My Saved Recipes</strong>.</p>

                <div id="modalErrorBox" class="alert alert-danger d-none mb-3"></div>

                <!-- KOMUNIKAT PRZY WYKRYCIU DUPLIKATU PRZEPISU -->
                <div id="modalOverwriteNotice" class="alert alert-warning d-none mb-3">
                    <p class="mb-2 fw-semibold" id="overwriteMsgText"></p>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" id="btnConfirmOverwrite" class="btn btn-sm btn-warning rounded-pill px-3 fw-bold">Overwrite Existing</button>
                        <button type="button" id="btnSaveAsNew" class="btn btn-sm btn-outline-dark rounded-pill px-3">Save as New Version</button>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Recipe Title</label>
                    <input type="text" id="customTitle" class="form-control rounded-3" value="@Model.StrMeal" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">My Ingredients (One per line)</label>
                    <textarea id="customIngredients" class="form-control rounded-3" rows="5">@string.Join(Environment.NewLine, ingredientsList)</textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">My Preparation Steps</label>
                    <textarea id="customInstructions" class="form-control rounded-3" rows="6">@string.Join(Environment.NewLine, steps)</textarea>
                </div>
            </div>
            <div class="modal-footer border-top-0 pt-0">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button"
                        id="saveCustomBtn"
                        class="btn btn-dark rounded-pill px-4"
                        data-externalid="@Model.IdMeal"
                        data-category="@Model.StrCategory"
                        data-area="@Model.StrArea"
                        data-thumb="@Model.StrMealThumb">
                    <span class="spinner-border spinner-border-sm me-2 d-none" id="saveSpinner" role="status" aria-hidden="true"></span>
                    <span id="saveBtnText">Save My Version</span>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/recipe-details.js" asp-append-version="true"></script>
}