@model IEnumerable<SmakoszApp.Models.Recipe>

@{
    ViewData["Title"] = "Moje przepisy";
}

@section Styles {
    <link rel="stylesheet" href="~/css/my-recipes.css" asp-append-version="true" />
}

<div class="my-recipes-wrapper">

    <div class="my-recipes-wrapper">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="success-alert">
                <span>@TempData["SuccessMessage"]</span>
                <button type="button" class="close-alert-btn" onclick="this.parentElement.style.display='none'">&times;</button>
            </div>
        }

    <h2 class="page-title">Wybierz przepis do edycji</h2>

    @if (!Model.Any())
    {
        <p class="empty-list-text">Nie masz jeszcze żadnych dodanych potraw.</p>
    }
    else
    {
        <div class="my-recipes-grid">
            @foreach (var recipe in Model)
            {
                <div class="recipe-card">
                    <img src="@recipe.ImagePath" alt="@recipe.Title" />
                    <div class="card-details">
                        <h3>@recipe.Title</h3>
                        <div class="action-buttons">
                            <a href="/Recipe/Edit/@recipe.Id" class="edit-link-btn">Edytuj</a>
                            <form method="post" action="/Recipe/Delete/@recipe.Id" onsubmit="return confirm('Czy na pewno chcesz usunąć ten przepis?');" style="display:inline;">
                                <button type="submit" class="delete-link-btn">Usuń</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>