@using System.Security.Claims
@inject SmakoszApp.Data.ApplicationDbContext DbContext

@{
    string userTheme = "light";
    string userAvatar = "/images/default-avatar.png";

    if (User.Identity?.IsAuthenticated == true)
    {
        var userIdStr = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (int.TryParse(userIdStr, out int userId))
        {
            var currentUser = DbContext.Users.Find(userId);
            if (currentUser != null)
            {
                userTheme = currentUser.ThemePreference ?? "light";
                if (!string.IsNullOrEmpty(currentUser.ProfilePicturePath))
                {
                    userAvatar = currentUser.ProfilePicturePath;
                }
            }
        }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Smakosz</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SmakoszApp.styles.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(userTheme == "dark" ? "dark-theme" : "")">

    @if (ViewData["HideNav"] == null || !(bool)ViewData["HideNav"])
    {
        <header>
            <nav class="custom-navbar">
                <div class="container-fluid navbar-container px-4">

                    <!-- Left Section -->
                    <div class="nav-left">
                        <a class="nav-link" href="/Community/Index">Community</a>
                        <a class="nav-link" href="/Community/Leaderboard">Leaderboard</a>
                        <a href="/Home/Contact" class="nav-link">Contact</a>
                    </div>

                    <!-- Center Brand (Logo Image) -->
                    <div class="nav-center">
                        <a href="/Home/Index" class="navbar-brand-logo">
                            <img src="~/logo.svg" alt="Smakosz Logo" class="nav-logo-img" />
                        </a>
                    </div>

                    <!-- Right Section -->
                    <div class="nav-right">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="dropdown d-inline-block">
                                <a href="#" class="nav-link fw-bold dropdown-toggle d-flex align-items-center gap-2" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                    <img src="@userAvatar" alt="Avatar" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 1.5px solid var(--color-dark, #2D3142);" />
                                    <span>@User.Identity.Name</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end custom-dropdown-menu" aria-labelledby="userMenu">
                                    <li><a class="dropdown-item custom-dropdown-item" href="/Recipe/Favorites">Favorites</a></li>
                                    <li><a class="dropdown-item custom-dropdown-item" href="/Recipe/Saved">My Saved Recipes</a></li>
                                    <li><a class="dropdown-item custom-dropdown-item" href="/Account/Settings">Account Settings</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item custom-dropdown-item text-danger" href="/Account/Logout">Log Out</a></li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a href="/Account/Index" class="nav-link">Log In</a>
                            <a href="/Account/Index?show=register" class="nav-link register-btn">Sign Up</a>
                        }
                    </div>

                </div>
            </nav>
        </header>
    }

    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <footer class="smakosz-simple-footer">
        <div class="footer-container">
            <!-- Footer Left: Essential Navigation -->
            <div class="footer-section footer-left">
                <span class="footer-heading">Navigation</span>
                <a href="/Home/Index" class="footer-link">Home</a>
                <a href="/Community/Leaderboard" class="footer-link">Leaderboard</a>
                <a href="/Home/Contact" class="footer-link">Contact</a>
            </div>

            <!-- Footer Center: Platform Tagline & Mission -->
            <div class="footer-section footer-center">
                <span class="footer-brand-title">smakosz</span>
                <p class="footer-tagline">Discover, rate, and personalize your favorite recipes from around the globe.</p>
            </div>

            <!-- Footer Right: Copyright & Extra Info -->
            <div class="footer-section footer-right">
                <span class="footer-heading">Platform</span>
                <span class="footer-info-text">Built for food enthusiasts</span>
                <span class="footer-copy">&copy; @DateTime.Now.Year Smakosz. All rights reserved.</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>