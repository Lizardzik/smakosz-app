@model SmakoszApp.Models.AccountViewModel

@{
    ViewData["Title"] = "Account";
    ViewData["HideNav"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
}

<div class="auth-container">

    <!-- Logo Section -->
    <div class="text-center mb-3">
        <a href="/Home/Index">
            <img src="~/logo.svg" alt="Smakosz Logo" class="auth-logo" />
        </a>
    </div>

    <!-- Auth Card -->
    <div class="auth-card">

        <!-- Form Switcher Tabs -->
        <div class="auth-tabs">
            <button type="button" class="auth-tab-btn active" id="tabLogin" onclick="showForm('login')">Log In</button>
            <button type="button" class="auth-tab-btn" id="tabRegister" onclick="showForm('register')">Sign Up</button>
        </div>

        <!-- LOGIN FORM -->
        <div id="loginForm" class="auth-form-content">
            <p class="auth-subtitle">Welcome back! Log in to access your saved recipes and ratings.</p>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success rounded-pill mt-2 mb-3 text-center" style="font-size: 0.9rem;">
                    @TempData["SuccessMessage"]
                </div>
            }

            <div asp-validation-summary="All" class="text-danger mb-3 validation-summary-errors text-center"></div>

            <form asp-action="Login" method="post">
                <input type="text" class="auth-input" asp-for="Login" placeholder="Username" required autocomplete="username" />
                <input type="password" class="auth-input" asp-for="Password" placeholder="Password" required autocomplete="current-password" />

                <button type="submit" class="auth-btn">Log In</button>
            </form>

            <div class="mt-4 text-center">
                <a href="javascript:void(0)" onclick="showForm('register')" class="auth-link">Don't have an account? Sign Up</a>
            </div>
        </div>

        <!-- REGISTER FORM -->
        <div id="registerForm" class="auth-form-content d-none">
            <p class="auth-subtitle">Join our culinary community to save, rate, and customize recipes!</p>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success rounded-pill mt-2 mb-3 text-center" style="font-size: 0.9rem;">
                    @TempData["SuccessMessage"]
                </div>
            }

            <div asp-validation-summary="All" class="text-danger mb-3 validation-summary-errors text-center"></div>

            <form asp-action="Register" method="post">
                <input type="email" class="auth-input" asp-for="Email" placeholder="E-mail Address" required autocomplete="email" />
                <input type="text" class="auth-input" asp-for="Login" placeholder="Username" required autocomplete="username" />
                <input type="password" class="auth-input" asp-for="Password" placeholder="Password" required autocomplete="new-password" />

                <button type="submit" class="auth-btn">Create Account</button>
            </form>

            <div class="mt-4 text-center">
                <a href="javascript:void(0)" onclick="showForm('login')" class="auth-link">Already have an account? Log In</a>
            </div>
        </div>

    </div>

    <!-- Guest Action -->
    <div class="mt-4 text-center">
        <a href="/Account/Guest" class="guest-btn">Continue as Guest &rarr;</a>
    </div>

</div>

@section Scripts {
    <script src="~/js/account.js" asp-append-version="true"></script>
}